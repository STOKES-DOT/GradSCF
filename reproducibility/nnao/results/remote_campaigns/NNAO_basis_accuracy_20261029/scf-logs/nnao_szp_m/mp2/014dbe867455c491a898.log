"""GPU4PySCF-only electronic calculations on pre-exported, frozen bases."""
from pathlib import Path
import argparse
import gc
import hashlib
import importlib.metadata as metadata
import json
import os
import resource
import threading
import time
import traceback

import cupy as cp
import numpy as np
from pyscf import gto,lib
from gpu4pyscf.scf import hf
from gpu4pyscf.dft import rks
from gpu4pyscf.mp import dfmp2
from protocols import basis_counts,frozen_core_count,cp_estimate

ROOT=Path(__file__).resolve().parent
DRIVER_SHA=hashlib.sha256(Path(__file__).read_bytes()+(ROOT/'protocols.py').read_bytes()).hexdigest()
SETTINGS=json.loads((ROOT/'inputs/settings.json').read_text())
AUXILIARY=json.loads((ROOT/'inputs/auxiliary-bases.json').read_text())
ROWS={r['structure_id']:r for r in json.loads((ROOT/'inputs/structures.json').read_text())}
VERSIONS={name:metadata.version(name) for name in ['pyscf','gpu4pyscf-cuda12x','cupy-cuda12x','cutensor-cu12','numpy','scipy']}
lib.num_threads(int(os.environ.get('SLURM_CPUS_PER_TASK','16')))


def write(path,row):
    path.parent.mkdir(parents=True,exist_ok=True)
    temp=path.with_suffix('.tmp');temp.write_text(json.dumps(row,indent=2,allow_nan=False)+'\n');temp.replace(path)


def digest(value):
    return hashlib.sha256(json.dumps(value,sort_keys=True).encode()).hexdigest()


def load_basis(key):
    data=json.loads((ROOT/'frozen'/f'{key}.json').read_text())
    return data,{r['structure_id']:r for r in data['records']}


def molecule(row,shells,active=None,output=None):
    active=set(range(len(shells))) if active is None else set(active)
    labels=[f'{s}{i}' if i in active else f'ghost-{s}{i}' for i,s in enumerate(row['symbols'])]
    mol=gto.M(atom=list(zip(labels,row['coords_angstrom'])),basis=dict(zip(labels,shells)),
        unit='Angstrom',charge=0,spin=0,cart=False,verbose=4 if output else 0,
        output=str(output) if output else None,max_memory=50000)
    assert mol.nao_nr()==basis_counts(shells)['nao_spherical']
    assert mol.nelectron==sum(z for i,z in enumerate(row['atomic_numbers']) if i in active)
    return mol


class MemorySample:
    def __enter__(self):
        self.stop=threading.Event();self.peak=0
        self.total=cp.cuda.runtime.memGetInfo()[1]
        self.baseline=self.total-cp.cuda.runtime.memGetInfo()[0]
        def sample():
            with cp.cuda.Device(0):
                while not self.stop.is_set():
                    self.peak=max(self.peak,self.total-cp.cuda.runtime.memGetInfo()[0])
                    self.stop.wait(.1)
        self.thread=threading.Thread(target=sample,daemon=True);self.thread.start()
        return self
    def __exit__(self,*args):
        self.stop.set();self.thread.join()


def solve(key,identifier,method,*,shells=None,row=None,active=None,variant='physical',level=3,auxiliary_identifier=None,
          jkfit=None,mp2fit=None):
    basis,records=load_basis(key)
    row=ROWS[identifier] if row is None else row
    shells=records[identifier]['atom_shells'] if shells is None else shells
    jkfit=SETTINGS['jkfit'] if jkfit is None else jkfit
    mp2fit=SETTINGS['mp2fit'] if mp2fit is None else mp2fit
    identity=dict(driver_sha256=DRIVER_SHA,key=key,row=row,shells=shells,method=method,active=active,variant=variant,
                  grid_level=level,jkfit=jkfit,mp2fit=mp2fit,auxiliary_identifier=auxiliary_identifier,
                  auxiliary_sha256=digest(AUXILIARY),settings=SETTINGS,versions=VERSIONS)
    signature=digest(identity);path=ROOT/'results'/key/method/(signature[:20]+'.json')
    if path.exists():
        saved=json.loads(path.read_text())
        if saved.get('status')=='passed' and saved['signature']==signature:return saved
    log=ROOT/'scf-logs'/key/method/(signature[:20]+'.log');log.parent.mkdir(parents=True,exist_ok=True)
    gc.collect();cp.get_default_memory_pool().free_all_blocks()
    start=time.perf_counter()
    result=dict(status='running',signature=signature,driver_sha256=DRIVER_SHA,basis_key=key,structure_id=identifier,
        method=method,variant=variant,active_nuclei=active,grid_level=level,
        auxiliary_identifier=auxiliary_identifier,
        jkfit=jkfit,mp2fit=mp2fit,
        timing_note='First evaluation in a persistent worker; kernel cache may be warm; not controlled hot timing',
        basis_file_sha256=hashlib.sha256((ROOT/'frozen'/f'{key}.json').read_bytes()).hexdigest(),
        counts=basis_counts(shells),device=cp.cuda.runtime.getDeviceProperties(0)['name'].decode(),
        versions=VERSIONS,cuda_runtime_version=cp.cuda.runtime.runtimeGetVersion(),
        job_id=os.environ.get('SLURM_JOB_ID'))
    mf=pt=None
    try:
        mol=molecule(row,shells,active=active,output=log)
        jk_aux=mp2_aux=None
        if auxiliary_identifier is not None:
            from pyscf.df.addons import make_auxmol
            scaffold=molecule(ROWS[auxiliary_identifier],records[auxiliary_identifier]['atom_shells'])
            jk_aux=make_auxmol(scaffold,AUXILIARY['bases'][jkfit])
            mp2_aux=make_auxmol(scaffold,AUXILIARY['bases'][mp2fit])
        with MemorySample() as memory:
            mf=(hf.RHF(mol) if method=='mp2' else rks.RKS(mol,xc='wb97m-v')).density_fit(auxbasis=AUXILIARY['bases'][jkfit])
            if jk_aux is not None:mf.with_df.auxmol=jk_aux
            assert type(mf).__module__.startswith('gpu4pyscf')
            mf.conv_tol=SETTINGS['conv_tol'];mf.conv_tol_grad=SETTINGS['conv_tol_grad']
            mf.max_cycle=SETTINGS['max_cycle'];mf.chkfile=None;mf.init_guess='minao'
            mf.level_shift=0.;mf.damp=0.
            if method!='mp2':
                mf.grids.level=level;mf.nlcgrids.level=level
                assert mf.do_nlc(),'VV10 must be enabled'
            tick=time.perf_counter();mf.kernel();rescued=False
            if not mf.converged:
                rescued=True;mf.level_shift=.2;mf.damp=.2;mf.kernel(dm0=mf.make_rdm1())
                seed=mf.make_rdm1();mf.level_shift=0.;mf.damp=0.;mf.kernel(dm0=seed)
            cp.cuda.get_current_stream().synchronize()
            assert mf.converged and mf.level_shift==0.,'Unshifted SCF failed'
            result.update(scf_seconds=time.perf_counter()-tick,scf_energy_hartree=float(mf.e_tot),
                scf_cycles=int(getattr(mf,'cycles',0)),rescue_used=rescued,solver_class=type(mf).__module__)
            number=float(cp.einsum('ij,ji',mf.make_rdm1(),mf.get_ovlp()))
            assert abs(number-mol.nelectron)<1e-7
            energy=float(mf.e_tot)
            if method=='mp2':
                ncore=frozen_core_count(mol.atom_charges())
                pt=dfmp2.DFMP2(mf,frozen=ncore,auxbasis=mp2_aux if mp2_aux is not None else AUXILIARY['bases'][mp2fit])
                pt.fp_type='FP64';pt.with_t2=False
                tick=time.perf_counter();pt.kernel();cp.cuda.get_current_stream().synchronize()
                assert pt.t2 is None and type(pt).__module__.startswith('gpu4pyscf')
                energy+=float(pt.e_corr)
                result.update(correlation_energy_hartree=float(pt.e_corr),frozen_core=ncore,
                    mp2_seconds=time.perf_counter()-tick,mp2_class=type(pt).__module__,fp_type='FP64',with_t2=False)
            else:
                result.update(nlc_enabled=bool(mf.do_nlc()),grid_points=len(mf.grids.weights),
                              nlc_grid_points=len(mf.nlcgrids.weights))
                assert result['nlc_grid_points']>0
            assert np.isfinite(energy)
            result.update(status='passed',energy_hartree=energy,electron_number=number,
                nocc=mol.nelectron//2,nvir=mol.nao_nr()-mol.nelectron//2,
                gpu_baseline_bytes=memory.baseline,gpu_peak_sampled_bytes=memory.peak,
                cupy_pool_reserved_bytes=cp.get_default_memory_pool().total_bytes())
        result.update(seconds=time.perf_counter()-start,process_max_rss_kib=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)
    except Exception as error:
        result.update(status='failed',error=str(error),traceback=traceback.format_exc(),seconds=time.perf_counter()-start)
        write(ROOT/'failures'/key/method/(signature[:20]+f'-{time.time_ns()}.json'),result)
    write(path,result)
    print('CASE',key,identifier,method,variant,result['status'],result.get('energy_hartree'),result['seconds'],flush=True)
    del mf,pt
    gc.collect();cp.get_default_memory_pool().free_all_blocks()
    if result['status']!='passed':raise RuntimeError(f'{key}/{identifier}/{method}: {result["error"]}')
    return result


def cpu_check(key,identifier,method,gpu,*,active=None,auxiliary_identifier=None):
    from pyscf import scf,dft,mp,df
    _,records=load_basis(key);row=ROWS[identifier]
    mol=molecule(row,records[identifier]['atom_shells'],active=active)
    mf=(scf.RHF(mol) if method=='mp2' else dft.RKS(mol,xc='wb97m-v')).density_fit(auxbasis=AUXILIARY['bases'][SETTINGS['jkfit']])
    mp2_aux=None
    if auxiliary_identifier is not None:
        from pyscf.df.addons import make_auxmol
        scaffold=molecule(ROWS[auxiliary_identifier],records[auxiliary_identifier]['atom_shells'])
        mf.with_df.auxmol=make_auxmol(scaffold,AUXILIARY['bases'][SETTINGS['jkfit']])
        mp2_aux=make_auxmol(scaffold,AUXILIARY['bases'][SETTINGS['mp2fit']])
    mf.conv_tol=SETTINGS['conv_tol'];mf.conv_tol_grad=SETTINGS['conv_tol_grad'];mf.max_cycle=200;mf.chkfile=None
    if method!='mp2':mf.grids.level=3;mf.nlcgrids.level=3;assert mf.do_nlc()
    mf.kernel();assert mf.converged
    energy=float(mf.e_tot)
    if method=='mp2':
        fitting=df.DF(mol,auxbasis=AUXILIARY['bases'][SETTINGS['mp2fit']])
        pt=mp.MP2(mf,frozen=frozen_core_count(mol.atom_charges())).density_fit(
            auxbasis=AUXILIARY['bases'][SETTINGS['mp2fit']],with_df=fitting)
        assert pt.with_df._cderi is None
        if mp2_aux is not None:pt.with_df.auxmol=mp2_aux
        pt.kernel(with_t2=False);energy+=float(pt.e_corr)
    error=abs(energy-gpu['energy_hartree']);tolerance=1e-7 if method=='mp2' else 1e-6
    assert error<tolerance,(identifier,method,error,tolerance)
    return dict(key=key,structure_id=identifier,method=method,active_nuclei=active,
                cpu_energy_hartree=energy,gpu_energy_hartree=gpu['energy_hartree'],error_hartree=error,tolerance=tolerance)


def cp_diagnostics(key,identifier,method):
    basis,records=load_basis(key);row=ROWS[identifier];shells=records[identifier]['atom_shells']
    total=solve(key,identifier,method)['energy_hartree'];isolated=[];conditioned=[];ghosts=[]
    for letter,indices in zip('AB',row['fragment_indices']):
        isolated.append(solve(key,identifier+'/'+letter,method)['energy_hartree'])
        ghosts.append(solve(key,identifier,method,active=indices,variant='ghost-'+letter,
                            auxiliary_identifier=identifier)['energy_hartree'])
        if basis['kind']=='nnao':
            fragment=ROWS[identifier+'/'+letter]
            conditioned.append(solve(key,identifier+'/'+letter,method,row=fragment,
                shells=[shells[i] for i in indices],variant='conditioned-'+letter,
                auxiliary_identifier=identifier)['energy_hartree'])
        else:conditioned.append(isolated[-1])
    result=cp_estimate(total,isolated,conditioned,ghosts)
    result.update(basis_key=key,structure_id=identifier,method=method,
        cp_kind='frozen-parameter CP estimate' if basis['kind']=='nnao' else 'standard CP')
    write(ROOT/'cp'/key/method/(identifier.replace('/','-')+'.json'),result)
    return result


def preflight():
    import importlib.metadata as metadata
    gate=json.loads((ROOT/'export-gate.json').read_text());assert gate['status']=='passed'
    for name,sha in gate['files'].items():assert hashlib.sha256((ROOT/'frozen'/name).read_bytes()).hexdigest()==sha
    cp.zeros(1,dtype=cp.float64);cp.cuda.get_current_stream().synchronize()
    cases=[];checks=[]
    families=[f'nnao_{z}p_{s}' for z in ['sz','dz','tz'] for s in ['s','m','l']]
    for key in families:
        for method in SETTINGS['methods']:cases.append(solve(key,'S22/02/A',method))
    for key in ['t01','t14','reference']:
        for identifier in ['ISO34/E14','S22/02','S22/10']:
            for method in SETTINGS['methods']:cases.append(solve(key,identifier,method))
    for key in ['t01','t14','nnao_szp_l']:
        for method in SETTINGS['methods']:
            result=solve(key,'S22/02/A',method);cases.append(result);checks.append(cpu_check(key,'S22/02/A',method,result))
    for key in ['t01','nnao_szp_l']:
        for method in SETTINGS['methods']:
            row=ROWS['S22/02'];active=row['fragment_indices'][0]
            result=solve(key,'S22/02',method,active=active,variant='ghost-A',auxiliary_identifier='S22/02');cases.append(result)
            checks.append(cpu_check(key,'S22/02',method,result,active=active,auxiliary_identifier='S22/02'))
    grid_checks=[];fit_checks=[]
    for key in ['t14','nnao_szp_l','reference']:
        energies={}
        for level in [3,5]:
            energies[level]=[solve(key,sid,'wb97m-v',level=level)['energy_hartree']
                             for sid in ['S22/02','S22/02/A','S22/02/B']]
        interaction=lambda e:e[0]-e[1]-e[2]
        grid_checks.append(dict(basis_key=key,water_interaction_level3_hartree=interaction(energies[3]),
            water_interaction_level5_hartree=interaction(energies[5]),
            difference_kcal_mol=(interaction(energies[5])-interaction(energies[3]))*627.5094740631))
    for key in ['t14','nnao_szp_l']:
        for method in SETTINGS['methods']:
            base=solve(key,'S22/02/A',method)
            control=solve(key,'S22/02/A',method,jkfit='cc-pvqz-jkfit',variant='jkfit-control')
            fit_checks.append(dict(basis_key=key,method=method,kind='jkfit',
                difference_hartree=control['energy_hartree']-base['energy_hartree']))
        base=solve(key,'S22/02/A','mp2')
        control=solve(key,'S22/02/A','mp2',mp2fit='def2-qzvpp-ri',variant='mp2fit-control')
        fit_checks.append(dict(basis_key=key,method='mp2',kind='correlation-fit',
            difference_hartree=control['energy_hartree']-base['energy_hartree']))
    assert max(abs(r['difference_hartree']) for r in fit_checks)<1e-5,fit_checks
    all_cases=[json.loads(p.read_text()) for p in (ROOT/'results').glob('*/*/*.json')]
    all_cases=[r for r in all_cases if r.get('driver_sha256')==DRIVER_SHA and r['status']=='passed']
    write(ROOT/'preflight.json',dict(status='passed',driver_sha256=DRIVER_SHA,case_references=len(cases),cpu_gpu_checks=checks,
        unique_gpu_cases=len(all_cases),auxiliary_fit_gate_hartree=1e-5,
        grid_sensitivity=grid_checks,auxiliary_fit_sensitivity=fit_checks,
        device=cp.cuda.runtime.getDeviceProperties(0)['name'].decode(),max_nao=max(r['counts']['nao_spherical'] for r in cases),
        max_gpu_peak_sampled_bytes=max(r['gpu_peak_sampled_bytes'] for r in all_cases),
        max_process_rss_kib=max(r['process_max_rss_kib'] for r in all_cases),
        versions={n:metadata.version(n) for n in ['pyscf','gpu4pyscf-cuda12x','cupy-cuda12x']},
        all_nine_models_exercised=True,vv10_and_ghosts_exercised=True,with_t2=False,fp_type='FP64'))


def main():
    p=argparse.ArgumentParser();p.add_argument('--preflight',action='store_true');p.add_argument('--lane',choices=['small','tz','qz'])
    p.add_argument('--direct',action='store_true',help='Run frozen benchmark directly, as explicitly requested; no CPU comparisons')
    args=p.parse_args()
    if args.preflight:preflight();return
    assert args.lane is not None,'Specify --lane'
    if args.direct:
        gate=json.loads((ROOT/'export-gate.json').read_text());assert gate['status']=='passed'
        for name,sha in gate['files'].items():
            assert hashlib.sha256((ROOT/'frozen'/name).read_bytes()).hexdigest()==sha,name
    else:
        gate=json.loads((ROOT/'preflight.json').read_text())
        assert gate['status']=='passed' and gate['driver_sha256']==DRIVER_SHA
    groups=dict(small=['t%02d'%i for i in [0,1,2,3,4,5,8,9,14,15]]+
                [f'nnao_{z}p_{s}' for z in ['sz','dz'] for s in ['s','m','l']],
        tz=['t%02d'%i for i in [6,7,10,11,16]]+[f'nnao_tzp_{s}' for s in ['s','m','l']],
        qz=['t12','t13','t17','reference'])
    failures=[];started=time.perf_counter()
    for key in groups[args.lane]:
        for identifier in ROWS:
            for method in SETTINGS['methods']:
                try:solve(key,identifier,method)
                except Exception as error:failures.append(str(error))
        for identifier,row in ROWS.items():
            if row.get('task')!='dimer':continue
            for method in SETTINGS['methods']:
                try:cp_diagnostics(key,identifier,method)
                except Exception as error:failures.append(str(error))
    write(ROOT/f'lane-{args.lane}.json',dict(status='passed' if not failures else 'failed',
        failures=failures,seconds=time.perf_counter()-started,bases=groups[args.lane],
        execution_mode='direct' if args.direct else 'validated',cpu_comparisons_run=False))
    if failures:raise RuntimeError(f'{len(failures)} explicit failed cases; no score will omit them')


if __name__=='__main__':main()
