@@ -1,6 +1,7 @@
 """True-residual regression for restarted JAX GMRES's early-inner-exit path."""
 import jax
 import jax.numpy as jnp
+from importlib import import_module
 import numpy as np
 import pytest
 from gradscf.solvers import solve_linear, LinearSolverConfig
@@ -18,3 +19,60 @@ def test_gmres_early_exit_retains_requested_accuracy(scale):
     derivative = jax.grad(lambda shift:jnp.sum(solve_linear(
         jnp.diag(diagonal+shift),rhs,config=cfg).solution))(0.)
     np.testing.assert_allclose(derivative,-jnp.sum(rhs/diagonal**2),rtol=1e-8,atol=scale*1e-10)
+
+
+@pytest.mark.parametrize('scale', [1., 1e-10])
+def test_gmres_retry_meets_true_residual_despite_optimistic_upstream_stop(monkeypatch, scale):
+    """An upstream success flag can underestimate the true residual by 20%."""
+    def optimistic_gmres(matvec, rhs, *, tol, atol, **kwargs):
+        matrix = jax.vmap(matvec, in_axes=1, out_axes=1)(jnp.eye(rhs.size))
+        exact = jnp.linalg.solve(matrix, rhs)
+        direction = jnp.eye(rhs.size)[0]
+        # Simulate early stopping at an optimistic residual estimate. The
+        # perturbation scales with the solver's requested accuracy, independent
+        # of which retry algorithm is selected.
+        defect = 1.2 * (tol * jnp.linalg.norm(rhs) + atol)
+        candidate = exact + direction * defect / jnp.linalg.norm(matvec(direction))
+        return candidate, jnp.asarray(0)
+
+    monkeypatch.setattr(import_module('gradscf.solvers.linear.gmres'), 'gmres', optimistic_gmres)
+    matrix = jnp.array([[2., .3], [-.2, 1.4]])
+    rhs = scale * jnp.array([.7, -.4])
+    config = LinearSolverConfig(rtol=1e-9, atol=scale * 1e-12)
+    result = jax.jit(lambda b: solve_linear(matrix, b, config=config))(rhs)
+    assert result.converged, result.residual_norm
+    assert result.residual_norm <= config.atol + config.rtol * jnp.linalg.norm(rhs)
+    np.testing.assert_allclose(result.solution, np.linalg.solve(matrix, rhs),
+                               rtol=1e-9, atol=scale * 1e-12)
+
+
+def test_gmres_inaccurate_retry_is_still_rejected(monkeypatch):
+    def inaccurate_gmres(matvec, rhs, **kwargs):
+        # Both upstream paths falsely report success with a finite bad candidate.
+        return jnp.zeros_like(rhs), jnp.asarray(0)
+
+    monkeypatch.setattr(import_module('gradscf.solvers.linear.gmres'), 'gmres', inaccurate_gmres)
+    result = solve_linear(jnp.array([[2., .3], [-.2, 1.4]]),
+                          jnp.array([.7, -.4]), config=LinearSolverConfig(rtol=1e-9))
+    assert not result.converged
+    assert int(result.status) == 1
+    assert np.isnan(result.solution).all()
+
+
+@pytest.mark.parametrize('scale', [1., 1e-10])
+def test_gmres_defect_correction_recovers_requested_accuracy(monkeypatch, scale):
+    """A consistently imperfect solve can still accurately correct its defect."""
+    def approximate_gmres(matvec, rhs, **kwargs):
+        matrix = jax.vmap(matvec, in_axes=1, out_axes=1)(jnp.eye(rhs.size))
+        # Asking for tighter stopping does not fix this approximate backend.
+        return jnp.linalg.solve(matrix, rhs) * (1. - 1e-5), jnp.asarray(0)
+
+    monkeypatch.setattr(import_module('gradscf.solvers.linear.gmres'), 'gmres', approximate_gmres)
+    matrix = jnp.array([[2., .3], [-.2, 1.4]])
+    rhs = scale * jnp.array([.7, -.4])
+    config = LinearSolverConfig(rtol=1e-9, atol=0.)
+    result = jax.jit(lambda b: solve_linear(matrix, b, config=config))(rhs)
+    assert result.converged, result.residual_norm
+    assert result.residual_norm <= config.rtol * jnp.linalg.norm(rhs)
+    np.testing.assert_allclose(result.solution, np.linalg.solve(matrix, rhs),
+                               rtol=2e-10, atol=scale * 1e-12)
